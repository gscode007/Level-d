rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing personal data remains owner scoped. The Admin API handles
    // challenge access: client SDKs never read or mutate these collections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /levels/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /arcs/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /completions/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /xpAudit/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    }
    match /challenges/{document=**} { allow read, write: if false; }
    match /challengeInvites/{document=**} { allow read, write: if false; }
    match /challengeJobs/{document=**} { allow read, write: if false; }
  }
}
