VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Layer 1: observability (all optional; unset = no-op) ──
# Client error reporting (Sentry browser). Leave blank to disable.
VITE_SENTRY_DSN=
# Server error reporting (Sentry node) for the MCP serverless function.
SENTRY_DSN=
# Vercel Analytics needs no env var — enable it on the Vercel project.

# ── Layer 3: rate limiting (Upstash Redis REST) ──
# Leave blank to disable rate limiting (fail-open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
