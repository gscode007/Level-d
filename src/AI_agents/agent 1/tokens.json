{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "$metadata": {
    "name": "Leveld Agent Design Tokens",
    "version": "1.0.0",
    "description": "Production design tokens for the AI agent sub-system inside Leveld. Calm clinical surface inside a gamified app.",
    "personality": "MINIMAL + TECHNICAL"
  },

  "color": {
    "primary": {
      "50":  { "$value": "#F0F1FE", "$type": "color", "$description": "Subtle backgrounds, hover on light surfaces" },
      "100": { "$value": "#E0E3FC", "$type": "color", "$description": "Selected backgrounds, soft brand fills" },
      "200": { "$value": "#C5CAFA", "$type": "color", "$description": "Borders on tinted brand surfaces, dividers" },
      "300": { "$value": "#A1A8F5", "$type": "color", "$description": "Disabled brand states, decorative graphics" },
      "400": { "$value": "#7B82EE", "$type": "color", "$description": "Brand color in dark mode (workhorse there)" },
      "500": { "$value": "#5C61E0", "$type": "color", "$description": "Brand base — the color people remember" },
      "600": { "$value": "#4338CA", "$type": "color", "$description": "Workhorse for primary actions in light mode (AA-safe)" },
      "700": { "$value": "#3730A3", "$type": "color", "$description": "Hover on primary actions, emphasized links" },
      "800": { "$value": "#2E2A80", "$type": "color", "$description": "Active/pressed state on primary actions" },
      "900": { "$value": "#1E1B4B", "$type": "color", "$description": "Highest-contrast brand text on light surfaces" },
      "950": { "$value": "#100F2B", "$type": "color", "$description": "Deep brand accent, never used for backgrounds in light mode" }
    },

    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color", "$description": "Pure white — surface base in light mode" },
      "50":  { "$value": "#FAFAF8", "$type": "color", "$description": "Slight warm off-white — page background fallback" },
      "100": { "$value": "#F4F4F0", "$type": "color", "$description": "Sunken surface, code blocks, secondary panels" },
      "200": { "$value": "#E8E8E1", "$type": "color", "$description": "Subtle borders, table dividers, hairlines" },
      "300": { "$value": "#D4D4CB", "$type": "color", "$description": "Default input borders, card outlines" },
      "400": { "$value": "#B0B0A4", "$type": "color", "$description": "Strong borders, disabled text on light" },
      "500": { "$value": "#8A8A7C", "$type": "color", "$description": "Tertiary text, helper text" },
      "600": { "$value": "#65655A", "$type": "color", "$description": "Secondary text, captions, muted UI" },
      "700": { "$value": "#4A4A42", "$type": "color", "$description": "Body text on muted contexts" },
      "800": { "$value": "#2E2E29", "$type": "color", "$description": "Dark surface raised in dark mode" },
      "900": { "$value": "#1A1A17", "$type": "color", "$description": "Default body text on light. Dark mode surface raised" },
      "950": { "$value": "#0E0E0C", "$type": "color", "$description": "Dark mode base surface — near-black with warm undertone" }
    },

    "success": {
      "subtle-bg": { "$value": "#ECFDF3", "$type": "color", "$description": "Inline success bg, badges" },
      "bg":        { "$value": "#10B981", "$type": "color", "$description": "Solid success surface (rare)" },
      "border":    { "$value": "#A7F3D0", "$type": "color", "$description": "Outline for success alerts" },
      "fg":        { "$value": "#059669", "$type": "color", "$description": "Success icons and text on neutral bg" },
      "fg-strong": { "$value": "#065F46", "$type": "color", "$description": "Emphasized success text" }
    },

    "warning": {
      "subtle-bg": { "$value": "#FEF7E0", "$type": "color", "$description": "Inline warning bg, badges" },
      "bg":        { "$value": "#D97706", "$type": "color", "$description": "Solid warning surface" },
      "border":    { "$value": "#FDE68A", "$type": "color", "$description": "Outline for warning alerts" },
      "fg":        { "$value": "#B45309", "$type": "color", "$description": "Warning icons and text on neutral bg" },
      "fg-strong": { "$value": "#78350F", "$type": "color", "$description": "Emphasized warning text" }
    },

    "danger": {
      "subtle-bg": { "$value": "#FEF2F2", "$type": "color", "$description": "Inline danger bg — muted, never alarming" },
      "bg":        { "$value": "#DC2626", "$type": "color", "$description": "Solid danger surface (used sparingly)" },
      "border":    { "$value": "#FECACA", "$type": "color", "$description": "Outline for danger alerts" },
      "fg":        { "$value": "#B91C1C", "$type": "color", "$description": "Danger icons and text" },
      "fg-strong": { "$value": "#7F1D1D", "$type": "color", "$description": "Emphasized danger text" }
    },

    "info": {
      "subtle-bg": { "$value": "#ECFEFF", "$type": "color", "$description": "Info bg — cyan to differentiate from indigo primary" },
      "bg":        { "$value": "#0891B2", "$type": "color", "$description": "Solid info surface" },
      "border":    { "$value": "#A5F3FC", "$type": "color", "$description": "Outline for info alerts" },
      "fg":        { "$value": "#0E7490", "$type": "color", "$description": "Info icons and text" },
      "fg-strong": { "$value": "#155E75", "$type": "color", "$description": "Emphasized info text" }
    }
  },

  "size": {
    "space": {
      "0":   { "$value": "0px",  "$type": "dimension", "$description": "No space — collapse" },
      "0-5": { "$value": "2px",  "$type": "dimension", "$description": "Hairline — borders, dividers" },
      "1":   { "$value": "4px",  "$type": "dimension", "$description": "Very tight — within tight components" },
      "2":   { "$value": "8px",  "$type": "dimension", "$description": "Tight — between related elements" },
      "3":   { "$value": "12px", "$type": "dimension", "$description": "Snug — between form fields" },
      "4":   { "$value": "16px", "$type": "dimension", "$description": "Default — between paragraphs" },
      "5":   { "$value": "20px", "$type": "dimension", "$description": "Comfortable — Agent default card padding" },
      "6":   { "$value": "24px", "$type": "dimension", "$description": "Loose — between component groups" },
      "8":   { "$value": "32px", "$type": "dimension", "$description": "Section padding within cards" },
      "10":  { "$value": "40px", "$type": "dimension", "$description": "Section spacing" },
      "12":  { "$value": "48px", "$type": "dimension", "$description": "Between major sections" },
      "16":  { "$value": "64px", "$type": "dimension", "$description": "Between major regions" },
      "20":  { "$value": "80px", "$type": "dimension", "$description": "Top-of-page hero padding" },
      "24":  { "$value": "96px", "$type": "dimension", "$description": "Large hero padding" }
    },
    "radius": {
      "none": { "$value": "0px",    "$type": "dimension", "$description": "Sharp corners — used for full-bleed sheets" },
      "xs":   { "$value": "2px",    "$type": "dimension", "$description": "Subtle softening — checkboxes, tags" },
      "sm":   { "$value": "4px",    "$type": "dimension", "$description": "Small radius — inputs, buttons" },
      "md":   { "$value": "6px",    "$type": "dimension", "$description": "Agent default — cards, modals, the workhorse" },
      "lg":   { "$value": "10px",   "$type": "dimension", "$description": "Larger cards, bottom sheets at corners" },
      "xl":   { "$value": "14px",   "$type": "dimension", "$description": "Hero containers (rare in Agent)" },
      "full": { "$value": "9999px", "$type": "dimension", "$description": "Pills, avatars, full-circle icons" }
    }
  },

  "typography": {
    "fontFamily": {
      "display": { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"], "$type": "fontFamily", "$description": "Same family as text — MINIMAL pattern" },
      "text":    { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"], "$type": "fontFamily", "$description": "Primary text family" },
      "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$type": "fontFamily", "$description": "Data only — timestamps, XP deltas, day counters. Never decorative." }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight", "$description": "Body text default" },
      "medium":   { "$value": 500, "$type": "fontWeight", "$description": "Slightly emphasized text, labels" },
      "semibold": { "$value": 600, "$type": "fontWeight", "$description": "Headings, primary button labels" },
      "bold":     { "$value": 700, "$type": "fontWeight", "$description": "Reserved — high emphasis only" }
    },
    "fontSize": {
      "xs":    { "$value": "12px", "$type": "dimension", "$description": "Captions, labels, fine print, mono timestamps" },
      "sm":    { "$value": "13px", "$type": "dimension", "$description": "Secondary body, helper text" },
      "base":  { "$value": "15px", "$type": "dimension", "$description": "Primary body text — slightly down from 16 for Agent density" },
      "lg":    { "$value": "18px", "$type": "dimension", "$description": "Lead paragraphs, larger body" },
      "xl":    { "$value": "22px", "$type": "dimension", "$description": "Card titles, section sub-headings" },
      "display-sm": { "$value": "26px", "$type": "dimension", "$description": "H3, mid-page headings" },
      "display-md": { "$value": "32px", "$type": "dimension", "$description": "H2, wizard step titles" },
      "display-lg": { "$value": "38px", "$type": "dimension", "$description": "H1, page titles — rare in Agent" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.15, "$type": "number", "$description": "Large headings" },
      "snug":    { "$value": 1.3,  "$type": "number", "$description": "Small headings, dense text" },
      "normal":  { "$value": 1.5,  "$type": "number", "$description": "Body text default" },
      "relaxed": { "$value": 1.6,  "$type": "number", "$description": "Long-form reading passages" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension", "$description": "Large display text" },
      "snug":   { "$value": "-0.01em", "$type": "dimension", "$description": "Mid-size headings" },
      "normal": { "$value": "0",       "$type": "dimension", "$description": "Body text" },
      "wide":   { "$value": "0.08em",  "$type": "dimension", "$description": "Uppercase section labels" }
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration", "$description": "Focus rings, micro-feedback — Agent is snappier than baseline" },
      "fast":    { "$value": "120ms", "$type": "duration", "$description": "Hover states, color transitions" },
      "base":    { "$value": "160ms", "$type": "duration", "$description": "Default UI transitions" },
      "slow":    { "$value": "240ms", "$type": "duration", "$description": "Modals appearing, drawers opening" },
      "slower":  { "$value": "360ms", "$type": "duration", "$description": "Bottom sheet entrances, streamed text reveal" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0, 0, 1],        "$type": "cubicBezier", "$description": "Default — fast start, slow end" },
      "in":       { "$value": [0.4, 0, 1, 1],        "$type": "cubicBezier", "$description": "Exits — element leaving" },
      "out":      { "$value": [0, 0, 0.2, 1],        "$type": "cubicBezier", "$description": "Entries — element entering" },
      "linear":   { "$value": [0, 0, 1, 1],          "$type": "cubicBezier", "$description": "Loaders, progress" }
    }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow", "$description": "No elevation. Agent default — borders carry separation." },
    "xs":   { "$value": "0 1px 2px rgba(14, 14, 12, 0.04)", "$type": "shadow", "$description": "Subtle resting lift" },
    "sm":   { "$value": "0 1px 3px rgba(14, 14, 12, 0.06), 0 1px 2px rgba(14, 14, 12, 0.04)", "$type": "shadow", "$description": "Cards at rest (rarely used in Agent)" },
    "md":   { "$value": "0 4px 8px rgba(14, 14, 12, 0.06), 0 2px 4px rgba(14, 14, 12, 0.04)", "$type": "shadow", "$description": "Popovers, dropdowns" },
    "lg":   { "$value": "0 12px 24px rgba(14, 14, 12, 0.08), 0 4px 8px rgba(14, 14, 12, 0.04)", "$type": "shadow", "$description": "Bottom sheets, side drawers" },
    "xl":   { "$value": "0 24px 48px rgba(14, 14, 12, 0.10), 0 8px 16px rgba(14, 14, 12, 0.06)", "$type": "shadow", "$description": "Modals" },
    "focus-ring": { "$value": "0 0 0 2px rgba(67, 56, 202, 0.5)", "$type": "shadow", "$description": "Keyboard focus indicator" }
  },

  "zIndex": {
    "base":      { "$value": 0,    "$type": "number" },
    "dropdown":  { "$value": 1000, "$type": "number" },
    "sticky":    { "$value": 1020, "$type": "number" },
    "banner":    { "$value": 1030, "$type": "number" },
    "overlay":   { "$value": 1040, "$type": "number" },
    "modal":     { "$value": 1050, "$type": "number" },
    "popover":   { "$value": 1060, "$type": "number" },
    "toast":     { "$value": 1070, "$type": "number" },
    "tooltip":   { "$value": 1080, "$type": "number" }
  },

  "breakpoint": {
    "sm":  { "$value": "640px",  "$type": "dimension", "$description": "Phone landscape, small tablet portrait" },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Tablet portrait" },
    "lg":  { "$value": "1024px", "$type": "dimension", "$description": "Tablet landscape, small laptop" },
    "xl":  { "$value": "1280px", "$type": "dimension", "$description": "Laptop, desktop" },
    "2xl": { "$value": "1536px", "$type": "dimension", "$description": "Large desktop" }
  },

  "light": {
    "surface": {
      "base":    { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Page background" },
      "raised":  { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Cards, modals (lift via border in Agent)" },
      "sunken":  { "$value": "{color.neutral.100}", "$type": "color", "$description": "Code blocks, input fills, secondary panels" },
      "overlay": { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Modal content, popovers" },
      "inverse": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Inverse surface (tooltips, inverted callouts)" },
      "agent":   { "$value": "{color.neutral.50}",  "$type": "color", "$description": "Agent message bubble — slight off-white to differentiate from user" }
    },
    "text": {
      "default":  { "$value": "{color.neutral.900}", "$type": "color", "$description": "Primary body text" },
      "muted":    { "$value": "{color.neutral.600}", "$type": "color", "$description": "Secondary text, captions" },
      "subtle":   { "$value": "{color.neutral.500}", "$type": "color", "$description": "Tertiary text, helper text" },
      "disabled": { "$value": "{color.neutral.400}", "$type": "color", "$description": "Disabled text" },
      "inverse":  { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Text on inverse surfaces" },
      "on-brand": { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Text on filled primary buttons" },
      "link":     { "$value": "{color.primary.600}", "$type": "color", "$description": "Link color" },
      "agent":    { "$value": "{color.neutral.900}", "$type": "color", "$description": "Agent voice — same as default for clinical neutrality" }
    },
    "border": {
      "subtle":  { "$value": "{color.neutral.200}", "$type": "color", "$description": "Dividers, table rows" },
      "default": { "$value": "{color.neutral.300}", "$type": "color", "$description": "Input borders, card borders" },
      "strong":  { "$value": "{color.neutral.400}", "$type": "color", "$description": "Emphasized borders" },
      "brand":   { "$value": "{color.primary.200}", "$type": "color", "$description": "Brand-tinted borders, focused inputs" }
    },
    "action": {
      "primary":         { "$value": "{color.primary.600}", "$type": "color" },
      "primary-hover":   { "$value": "{color.primary.700}", "$type": "color" },
      "primary-pressed": { "$value": "{color.primary.800}", "$type": "color" },
      "secondary":         { "$value": "{color.neutral.100}", "$type": "color" },
      "secondary-hover":   { "$value": "{color.neutral.200}", "$type": "color" },
      "secondary-pressed": { "$value": "{color.neutral.300}", "$type": "color" }
    },
    "focus-ring":         { "$value": "{color.primary.500}", "$type": "color" },
    "focus-ring-inverse": { "$value": "{color.neutral.0}",   "$type": "color" }
  },

  "dark": {
    "surface": {
      "base":    { "$value": "{color.neutral.950}", "$type": "color" },
      "raised":  { "$value": "{color.neutral.900}", "$type": "color" },
      "sunken":  { "$value": "{color.neutral.950}", "$type": "color" },
      "overlay": { "$value": "{color.neutral.800}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.50}",  "$type": "color" },
      "agent":   { "$value": "{color.neutral.800}", "$type": "color", "$description": "Agent bubble — slightly raised from base" }
    },
    "text": {
      "default":  { "$value": "{color.neutral.100}", "$type": "color" },
      "muted":    { "$value": "{color.neutral.400}", "$type": "color" },
      "subtle":   { "$value": "{color.neutral.500}", "$type": "color" },
      "disabled": { "$value": "{color.neutral.600}", "$type": "color" },
      "inverse":  { "$value": "{color.neutral.900}", "$type": "color" },
      "on-brand": { "$value": "{color.neutral.0}",   "$type": "color" },
      "link":     { "$value": "{color.primary.400}", "$type": "color" },
      "agent":    { "$value": "{color.neutral.100}", "$type": "color" }
    },
    "border": {
      "subtle":  { "$value": "{color.neutral.800}", "$type": "color" },
      "default": { "$value": "{color.neutral.700}", "$type": "color" },
      "strong":  { "$value": "{color.neutral.600}", "$type": "color" },
      "brand":   { "$value": "{color.primary.700}", "$type": "color" }
    },
    "action": {
      "primary":         { "$value": "{color.primary.500}", "$type": "color" },
      "primary-hover":   { "$value": "{color.primary.400}", "$type": "color" },
      "primary-pressed": { "$value": "{color.primary.600}", "$type": "color" },
      "secondary":         { "$value": "{color.neutral.800}", "$type": "color" },
      "secondary-hover":   { "$value": "{color.neutral.700}", "$type": "color" },
      "secondary-pressed": { "$value": "{color.neutral.600}", "$type": "color" }
    },
    "focus-ring":         { "$value": "{color.primary.400}", "$type": "color" },
    "focus-ring-inverse": { "$value": "{color.neutral.900}", "$type": "color" }
  }
}
